NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=8787
APP_ORIGIN=http://127.0.0.1:4173
PUBLIC_APP_ORIGIN=http://127.0.0.1:4173
ADMIN_APP_ORIGIN=http://127.0.0.1:4174
ADMIN_BASE_PATH=/admin
ADMIN_DISABLED_PATHS=
APP_HOST=127.0.0.1
# 独立域名部署示例：https://api.example.com、https://www.example.com、https://admin.example.com
VITE_API_BASE_URL=
VITE_PUBLIC_SITE_URL=
VITE_ADMIN_SITE_URL=
# 仅供管理端开发服务器使用；生产环境由 ADMIN_BASE_PATH 运行时注入。
VITE_ADMIN_BASE_PATH=/admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-random-password
APP_SECRET=replace-with-a-long-random-secret
SESSION_DAYS=7
# auto 会在 HTTPS 访问时启用 Secure；公网 IP+HTTP 模式保持可登录。
COOKIE_SECURE=auto
MAX_PACKAGE_BYTES=2147483648
MAX_SITE_ZIP_BYTES=52428800
MAX_BACKUP_BYTES=21474836480
MAX_UPDATE_BYTES=2147483648

# 系统更新：GitHub 仓库准备好后填入由 CI 发布的签名清单 URL。
UPDATE_MANIFEST_URL=
# Ed25519 公钥 PEM；换行可写成 \n。清单和公钥缺一不可，系统会拒绝更新。
UPDATE_PUBLIC_KEY=
# 可选：由进程管理器提供的安全更新执行器（禁止填写 shell 拼接命令）。
UPDATE_APPLY_COMMAND=
UPDATE_APPLY_ARGS_JSON=[]
STORAGE_PROVIDER=local
# 生产环境推荐 s3；兼容 Cloudflare R2、阿里 OSS、腾讯 COS 和其他 S3 服务
# 仅受控测试环境可以设为 true；正式生产环境必须保持 false 并使用对象存储
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=replace-with-bucket-name
S3_ACCESS_KEY=replace-with-access-key
S3_SECRET_KEY=replace-with-secret-key
S3_PUBLIC_BASE_URL=
STORAGE_URL_TTL=900
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
# S3 模式下将备份额外复制到 backups/ 前缀
BACKUP_REMOTE=false
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
CERTIFICATE_CALLBACK_SECRET=replace-with-certificate-callback-secret
# DNS_PROVIDER=manual 或 cloudflare；配置 cloudflare 后可从后台自动写入 TXT 验证记录
DNS_PROVIDER=manual
CERTIFICATE_PROVIDER=manual
CLOUDFLARE_API_TOKEN=replace-with-cloudflare-api-token
CLOUDFLARE_API_BASE=https://api.cloudflare.com/client/v4
DNS_WEBHOOK_URL=
DNS_WEBHOOK_SECRET=
