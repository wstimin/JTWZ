#!/usr/bin/env bash
set -Eeuo pipefail

APP_DIR="${JTWZ_APP_DIR:-/opt/jtwz}"
SERVICE_NAME="${JTWZ_SERVICE_NAME:-jtwz}"
ARCHIVE="${1:-}"
STATE_DIR="$APP_DIR/data/updates"
API_PORT="8787"
STAGING=''
NEXT=''
ROLLBACK=''
TARGET_DIR="$APP_DIR"
SWITCHED='false'
CONFIG_ENV="$APP_DIR/data/config.env"
SERVICE_USER="${JTWZ_SERVICE_USER:-jtwz}"
SERVICE_GROUP="${JTWZ_SERVICE_GROUP:-jtwz}"

say() { printf '\n[JTWZ Update] %s\n' "$*"; }
die() { printf '[JTWZ Update][错误] %s\n' "$*" >&2; exit 1; }

[[ "$(id -u)" == 0 ]] || die '请使用 root 执行更新。'
[[ "$APP_DIR" == /opt/jtwz || "$APP_DIR" == /opt/jtwz/* ]] || die "应用目录必须位于 /opt/jtwz：$APP_DIR"
[[ -f "$ARCHIVE" ]] || die '更新包不存在。'
command -v node >/dev/null || die '缺少 Node.js。'
command -v npm >/dev/null || die '缺少 npm。'
command -v tar >/dev/null || die '缺少 tar。'

verify_signed_artifact() {
  local state_file="$STATE_DIR/state.json" env_file="$APP_DIR/data/config.env"
  [[ -f "$state_file" ]] || die '缺少更新暂存状态，已拒绝执行。'
  [[ -f "$env_file" ]] || env_file="$TARGET_DIR/.env"
  [[ -f "$env_file" ]] || die '缺少运行配置，无法验证更新签名。'
  JTWZ_VERIFY_ARCHIVE="$ARCHIVE" JTWZ_VERIFY_STATE="$state_file" JTWZ_VERIFY_ENV="$env_file" node <<'NODE'
const fs = require('node:fs')
const crypto = require('node:crypto')
const path = require('node:path')
const archive = fs.realpathSync(process.env.JTWZ_VERIFY_ARCHIVE)
const state = JSON.parse(fs.readFileSync(process.env.JTWZ_VERIFY_STATE, 'utf8'))
const allowedDir = fs.realpathSync(path.dirname(process.env.JTWZ_VERIFY_STATE)) + path.sep
if (!archive.startsWith(allowedDir) || fs.realpathSync(state.artifact?.path || '') !== archive) throw new Error('更新包不属于已验证的暂存任务')
const env = Object.fromEntries(fs.readFileSync(process.env.JTWZ_VERIFY_ENV, 'utf8').split(/\r?\n/).filter(Boolean).filter(line => !line.trim().startsWith('#')).map(line => { const index = line.indexOf('='); return index > 0 ? [line.slice(0, index), line.slice(index + 1)] : ['', ''] }).filter(([key]) => key))
const manifest = state.manifest || {}
const digest = crypto.createHash('sha256').update(fs.readFileSync(archive)).digest('hex')
if (digest !== manifest.sha256 || digest !== state.artifact.sha256) throw new Error('更新包 SHA-256 与签名清单不一致')
const encodedPublicKey = String(env.UPDATE_PUBLIC_KEY_B64 || '').trim()
const publicKey = encodedPublicKey ? Buffer.from(encodedPublicKey, 'base64').toString('utf8') : String(env.UPDATE_PUBLIC_KEY || '').replace(/\\n/g, '\n')
const payload = [manifest.version, manifest.publishedAt || '', manifest.notes || '', manifest.downloadUrl, String(manifest.sha256 || '').toLowerCase()].join('\n')
if (!publicKey || !crypto.verify(null, Buffer.from(payload), publicKey, Buffer.from(String(manifest.signature || ''), 'base64'))) throw new Error('更新包 Ed25519 签名复核失败')
NODE
}

if [[ -f "$APP_DIR/docker-compose.yml" && -d "$APP_DIR/app" ]]; then TARGET_DIR="$APP_DIR/app"; fi
[[ -f "$CONFIG_ENV" ]] || CONFIG_ENV="$APP_DIR/.env"
if [[ -f "$CONFIG_ENV" ]]; then API_PORT="$(grep -E '^API_PORT=' "$CONFIG_ENV" | tail -n 1 | cut -d= -f2- || true)"; fi
API_PORT="${API_PORT:-8787}"
install -d -m 750 "$STATE_DIR"

write_state() {
  local status="$1" detail="$2" version="${3:-}"
  JTWZ_UPDATE_STATUS="$status" JTWZ_UPDATE_DETAIL="$detail" JTWZ_UPDATE_VERSION="$version" node - "$STATE_DIR/state.json" <<'NODE'
const fs = require('node:fs')
const target = process.argv[2]
const payload = { status: process.env.JTWZ_UPDATE_STATUS, detail: process.env.JTWZ_UPDATE_DETAIL, version: process.env.JTWZ_UPDATE_VERSION, updatedAt: new Date().toISOString() }
fs.writeFileSync(`${target}.tmp`, JSON.stringify(payload, null, 2), { mode: 0o600 })
fs.renameSync(`${target}.tmp`, target)
NODE
  if id -u "$SERVICE_USER" >/dev/null 2>&1; then chown "$SERVICE_USER:$SERVICE_GROUP" "$STATE_DIR/state.json"; fi
  chmod 640 "$STATE_DIR/state.json"
}

sanitize_legacy_public_key() {
  [[ -f "$CONFIG_ENV" ]] || return 0
  local temporary="$CONFIG_ENV.sanitize.$$"
  awk '
    BEGIN { skipping = 0 }
    /^UPDATE_PUBLIC_KEY=/ { skipping = 1; next }
    skipping && /^[A-Za-z_][A-Za-z0-9_]*=/ { skipping = 0 }
    skipping { next }
    { print }
  ' "$CONFIG_ENV" > "$temporary"
  chown --reference="$CONFIG_ENV" "$temporary"
  chmod --reference="$CONFIG_ENV" "$temporary"
  mv -f "$temporary" "$CONFIG_ENV"
}

verify_signed_artifact
write_state 'preparing' '更新包签名复核通过，正在解压并安装依赖。'

stop_service() {
  if [[ -f "$APP_DIR/docker-compose.yml" ]]; then (cd "$APP_DIR" && docker compose down); else systemctl stop "$SERVICE_NAME"; fi
}

start_service() {
  if [[ -f "$APP_DIR/docker-compose.yml" ]]; then (cd "$APP_DIR" && docker compose up -d --build); else systemctl daemon-reload; systemctl start "$SERVICE_NAME"; fi
}

wait_for_health() {
  local attempt
  for attempt in {1..45}; do
    if curl -fsS --connect-timeout 2 "http://127.0.0.1:$API_PORT/api/health" >/dev/null 2>&1; then return 0; fi
    sleep 1
  done
  return 1
}

restore_previous_code() {
  local item failure_detail="${1:-}"
  say '健康检查未通过，正在自动恢复上一版程序。'
  stop_service || true
  for item in package.json package-lock.json dist dist-server node_modules; do
    rm -rf "$TARGET_DIR/$item"
    [[ -e "$ROLLBACK/$item" ]] && mv "$ROLLBACK/$item" "$TARGET_DIR/"
  done
  for item in jtwzctl jtwz-update jtwz-update-dispatch jtwz-domain jtwz-domain-dispatch; do
    [[ -f "$ROLLBACK/bin/$item" ]] && install -m 755 "$ROLLBACK/bin/$item" "/usr/local/bin/$item"
  done
  start_service
  wait_for_health || true
  if [[ -n "$failure_detail" ]]; then
    write_state 'rolled_back' "新版本健康检查失败，已恢复上一版程序。原因：${failure_detail:0:600}" "${VERSION:-}"
  else
    write_state 'rolled_back' '新版本健康检查失败，已恢复上一版程序。' "${VERSION:-}"
  fi
}

service_failure_detail() {
  journalctl -u "${SERVICE_NAME}.service" -n 12 --no-pager -o cat 2>/dev/null \
    | grep -Ev '^(Started|Stopped|Stopping|Scheduled restart job)' \
    | tail -n 4 \
    | tr '\n' ' ' \
    | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//' \
    || true
}

on_error() {
  local code=$?
  trap - ERR
  if [[ "$SWITCHED" == 'true' && -n "$ROLLBACK" && -d "$ROLLBACK" ]]; then
    restore_previous_code "$(service_failure_detail)"
  else
    write_state 'failed' '更新准备阶段失败，现有服务未改动。请查看更新日志。' "${VERSION:-}"
  fi
  [[ -n "$STAGING" && -d "$STAGING" ]] && rm -rf "$STAGING"
  [[ -n "$NEXT" && -d "$NEXT" ]] && rm -rf "$NEXT"
  [[ -n "$ROLLBACK" && -d "$ROLLBACK" ]] && rm -rf "$ROLLBACK"
  exit "$code"
}
trap on_error ERR

STAGING="$(mktemp -d /tmp/jtwz-update-stage.XXXXXX)"
ROLLBACK="$(mktemp -d "$STATE_DIR/rollback.XXXXXX")"
tar -xzf "$ARCHIVE" -C "$STAGING"
SOURCE_APP="$(dirname "$(dirname "$(find "$STAGING" -path '*/app/dist-server/index.js' -type f -print -quit)")")"
[[ -f "$SOURCE_APP/package.json" && -f "$SOURCE_APP/dist-server/index.js" && -d "$SOURCE_APP/dist" ]] || die '更新包结构不完整。'
SOURCE_PACKAGE="$(dirname "$SOURCE_APP")"
VERSION="$(node -e "process.stdout.write(require(process.argv[1]).version || '')" "$SOURCE_APP/package.json")"
[[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.-]+)?$ ]] || die '更新包版本号无效。'

NEXT="$(mktemp -d "$STATE_DIR/next.XXXXXX")"
cp -a "$SOURCE_APP/package.json" "$SOURCE_APP/package-lock.json" "$SOURCE_APP/dist" "$SOURCE_APP/dist-server" "$NEXT/"
npm --prefix "$NEXT" ci --omit=dev

PREFLIGHT_LOG="$STAGING/production-preflight.log"
(
  cd "$NEXT"
  NODE_ENV=production API_HOST=127.0.0.1 API_PORT=0 DATA_DIR="$STAGING/preflight-data" \
    ADMIN_USERNAME=update-preflight ADMIN_PASSWORD=update-preflight-password APP_SECRET=update-preflight-secret \
    ALLOW_LOCAL_STORAGE_IN_PRODUCTION=true node dist-server/index.js > "$PREFLIGHT_LOG" 2>&1
) &
PREFLIGHT_PID=$!
sleep 2
if ! kill -0 "$PREFLIGHT_PID" >/dev/null 2>&1; then
  wait "$PREFLIGHT_PID" || true
  tail -n 12 "$PREFLIGHT_LOG" >&2 || true
  write_state 'failed' '更新包生产环境预检失败，现有服务未改动。请查看更新日志。' "$VERSION"
  false
fi
kill "$PREFLIGHT_PID" >/dev/null 2>&1 || true
wait "$PREFLIGHT_PID" 2>/dev/null || true

mkdir -p "$ROLLBACK/bin"
for item in jtwzctl jtwz-update jtwz-update-dispatch jtwz-domain jtwz-domain-dispatch; do
  [[ -f "/usr/local/bin/$item" ]] && cp -a "/usr/local/bin/$item" "$ROLLBACK/bin/$item"
done

write_state 'applying' "正在切换到 v$VERSION。" "$VERSION"
stop_service
SWITCHED='true'
for item in package.json package-lock.json dist dist-server node_modules; do
  [[ -e "$TARGET_DIR/$item" ]] && mv "$TARGET_DIR/$item" "$ROLLBACK/"
done
for item in package.json package-lock.json dist dist-server node_modules; do
  mv "$NEXT/$item" "$TARGET_DIR/"
done
if [[ -f "$SOURCE_PACKAGE/installer/jtwzctl" ]]; then install -m 755 "$SOURCE_PACKAGE/installer/jtwzctl" /usr/local/bin/jtwzctl; fi
if [[ -f "$SOURCE_PACKAGE/installer/jtwz-update" ]]; then install -m 755 "$SOURCE_PACKAGE/installer/jtwz-update" /usr/local/bin/jtwz-update; fi
if [[ -f "$SOURCE_PACKAGE/installer/jtwz-update-dispatch" ]]; then install -m 755 "$SOURCE_PACKAGE/installer/jtwz-update-dispatch" /usr/local/bin/jtwz-update-dispatch; fi
if [[ -f "$SOURCE_PACKAGE/installer/jtwz-domain" ]]; then install -m 755 "$SOURCE_PACKAGE/installer/jtwz-domain" /usr/local/bin/jtwz-domain; fi
if [[ -f "$SOURCE_PACKAGE/installer/jtwz-domain-dispatch" ]]; then install -m 755 "$SOURCE_PACKAGE/installer/jtwz-domain-dispatch" /usr/local/bin/jtwz-domain-dispatch; fi
sanitize_legacy_public_key
if [[ -f "/etc/systemd/system/${SERVICE_NAME}.service" ]]; then
  sed -i '/^NoNewPrivileges=true$/d' "/etc/systemd/system/${SERVICE_NAME}.service"
  sed -i "s#^ReadWritePaths=.*#ReadWritePaths=$APP_DIR -/usr/local/bin -/etc/systemd/system -/etc/sudoers.d -/etc/nginx -/etc/letsencrypt -/var/lib/letsencrypt -/var/log/letsencrypt#" "/etc/systemd/system/${SERVICE_NAME}.service"
fi
if id -u jtwz >/dev/null 2>&1 && [[ -x /usr/local/bin/jtwz-domain-dispatch ]]; then
  rm -f /etc/sudoers.d/jtwz-update
  install -d -o jtwz -g jtwz -m 750 "$APP_DIR/data/domain-jobs"
  if [[ -f "$CONFIG_ENV" ]]; then
    if grep -q '^DOMAIN_APPLY_COMMAND=' "$CONFIG_ENV"; then sed -i 's#^DOMAIN_APPLY_COMMAND=.*#DOMAIN_APPLY_COMMAND=/usr/local/bin/jtwz-domain-dispatch#' "$CONFIG_ENV"; else printf '\nDOMAIN_APPLY_COMMAND=/usr/local/bin/jtwz-domain-dispatch\n' >> "$CONFIG_ENV"; fi
    if grep -q '^DOMAIN_APPLY_ARGS_JSON=' "$CONFIG_ENV"; then sed -i 's#^DOMAIN_APPLY_ARGS_JSON=.*#DOMAIN_APPLY_ARGS_JSON=[]#' "$CONFIG_ENV"; else printf 'DOMAIN_APPLY_ARGS_JSON=[]\n' >> "$CONFIG_ENV"; fi
  fi
  cat > /etc/systemd/system/jtwz-domain-apply.service <<EOF
[Unit]
Description=JTWZ privileged domain and certificate apply service
After=network-online.target
[Service]
Type=oneshot
ExecStart=/usr/local/bin/jtwz-domain-dispatch --apply
User=root
Group=root
UMask=0027
EOF
  cat > /etc/systemd/system/jtwz-domain.path <<EOF
[Unit]
Description=Watch for JTWZ domain and certificate requests
[Path]
PathExists=$APP_DIR/data/domain-jobs/apply.request
Unit=jtwz-domain-apply.service
[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl enable --now jtwz-domain.path >/dev/null
fi
start_service
wait_for_health
write_state 'applied' "v$VERSION 已安装，数据库迁移与健康检查通过。" "$VERSION"
SWITCHED='false'
trap - ERR
rm -rf "$STAGING" "$NEXT" "$ROLLBACK"
say "v$VERSION 更新成功。"
