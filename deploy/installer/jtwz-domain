#!/usr/bin/env bash
set -Eeuo pipefail

APP_DIR="${JTWZ_APP_DIR:-/opt/jtwz}"
ACTION="${1:-}"
HOSTNAME="${2:-}"
ENV_FILE="$APP_DIR/data/config.env"
API_PORT='8787'
CONF_FILE="/etc/nginx/conf.d/jtwz-domain-$HOSTNAME.conf"

die() { printf '[JTWZ Domain][错误] %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "缺少命令：$1"; }

[[ "$(id -u)" == 0 ]] || die '域名执行器必须由 root 运行。'
[[ "$ACTION" =~ ^(route|ensure|remove|purge)$ ]] || die '操作仅支持 route、ensure、remove 或 purge。'
[[ "$HOSTNAME" =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$ ]] || die '域名格式无效。'
need nginx

if [[ -f "$ENV_FILE" ]]; then
  API_PORT="$(grep -E '^API_PORT=' "$ENV_FILE" | tail -n 1 | cut -d= -f2- || true)"
fi
API_PORT="${API_PORT:-8787}"
[[ "$API_PORT" =~ ^[0-9]{2,5}$ ]] || die 'API_PORT 配置无效。'

write_http_route() {
  cat > "$CONF_FILE" <<EOF
# Managed by JTWZ. Do not edit by hand.
server {
  listen 80;
  listen [::]:80;
  server_name $HOSTNAME;
  client_max_body_size 2g;
  location / {
    proxy_pass http://127.0.0.1:$API_PORT;
    proxy_http_version 1.1;
    proxy_set_header Host \$host;
    proxy_set_header X-Forwarded-Proto \$scheme;
    proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP \$remote_addr;
    proxy_request_buffering off;
  }
}
EOF
}

reload_nginx() {
  nginx -t
  systemctl reload nginx
}

case "$ACTION" in
  route)
    [[ -f "$CONF_FILE" ]] || write_http_route
    reload_nginx
    ;;
  ensure)
    [[ -f "$CONF_FILE" ]] || write_http_route
    reload_nginx
    need certbot
    if [[ -n "${JTWZ_CERTBOT_EMAIL:-}" ]]; then
      certbot --nginx --non-interactive --agree-tos --email "$JTWZ_CERTBOT_EMAIL" --redirect --keep-until-expiring -d "$HOSTNAME"
    else
      certbot --nginx --non-interactive --agree-tos --register-unsafely-without-email --redirect --keep-until-expiring -d "$HOSTNAME"
    fi
    reload_nginx
    ;;
  remove)
    command -v certbot >/dev/null 2>&1 && certbot delete --non-interactive --cert-name "$HOSTNAME" >/dev/null 2>&1 || true
    write_http_route
    reload_nginx
    ;;
  purge)
    command -v certbot >/dev/null 2>&1 && certbot delete --non-interactive --cert-name "$HOSTNAME" >/dev/null 2>&1 || true
    rm -f "$CONF_FILE"
    reload_nginx
    ;;
esac

printf '[JTWZ Domain] %s 完成：%s\n' "$ACTION" "$HOSTNAME"
