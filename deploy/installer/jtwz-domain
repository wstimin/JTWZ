#!/usr/bin/env bash
set -Eeuo pipefail

APP_DIR="${JTWZ_APP_DIR:-/opt/jtwz}"
ACTION="${1:-}"
HOSTNAME="${2:-}"
ENV_FILE="$APP_DIR/data/config.env"
API_PORT='8787'
CONF_FILE="/etc/nginx/conf.d/jtwz-domain-$HOSTNAME.conf"
CERT_DIR="/etc/letsencrypt/live/$HOSTNAME"

die() { printf '[JTWZ Domain][错误] %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "缺少命令：$1"; }

[[ "$(id -u)" == 0 ]] || die '域名执行器必须由 root 运行。'
[[ "$ACTION" =~ ^(route|ensure|check|remove|purge)$ ]] || die '操作仅支持 route、ensure、check、remove 或 purge。'
[[ "$HOSTNAME" =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$ ]] || die '域名格式无效。'
need nginx

if [[ -f "$ENV_FILE" ]]; then
  API_PORT="$(grep -E '^API_PORT=' "$ENV_FILE" | tail -n 1 | cut -d= -f2- || true)"
fi
API_PORT="${API_PORT:-8787}"
[[ "$API_PORT" =~ ^[0-9]{2,5}$ ]] || die 'API_PORT 配置无效。'

certificate_available() {
  [[ -r "$CERT_DIR/fullchain.pem" && -r "$CERT_DIR/privkey.pem" ]]
}

write_route() {
  if certificate_available; then
    cat > "$CONF_FILE" <<EOF
# Managed by JTWZ. Do not edit by hand.
server {
  listen 80;
  listen [::]:80;
  server_name $HOSTNAME;
  client_max_body_size 2g;
  location / {
    proxy_pass http://127.0.0.1:$API_PORT;
    proxy_http_version 1.1;
    proxy_set_header Host \$host;
    proxy_set_header X-Forwarded-Proto \$scheme;
    proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP \$remote_addr;
    proxy_request_buffering off;
  }
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  server_name $HOSTNAME;
  ssl_certificate $CERT_DIR/fullchain.pem;
  ssl_certificate_key $CERT_DIR/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
  client_max_body_size 2g;
  location / {
    proxy_pass http://127.0.0.1:$API_PORT;
    proxy_http_version 1.1;
    proxy_set_header Host \$host;
    proxy_set_header X-Forwarded-Proto \$scheme;
    proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP \$remote_addr;
    proxy_request_buffering off;
  }
}
EOF
    return
  fi
  cat > "$CONF_FILE" <<EOF
# Managed by JTWZ. Do not edit by hand.
server {
  listen 80;
  listen [::]:80;
  server_name $HOSTNAME;
  client_max_body_size 2g;
  location / {
    proxy_pass http://127.0.0.1:$API_PORT;
    proxy_http_version 1.1;
    proxy_set_header Host \$host;
    proxy_set_header X-Forwarded-Proto \$scheme;
    proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP \$remote_addr;
    proxy_request_buffering off;
  }
}
EOF
}

reload_nginx() {
  nginx -t
  systemctl reload nginx
}

open_web_ports() {
  if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q '^Status: active'; then
    ufw allow 80/tcp >/dev/null
    ufw allow 443/tcp >/dev/null
  elif command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state >/dev/null 2>&1; then
    firewall-cmd --permanent --add-service=http >/dev/null
    firewall-cmd --permanent --add-service=https >/dev/null
    firewall-cmd --reload >/dev/null
  fi
}

case "$ACTION" in
  route)
    open_web_ports
    write_route
    reload_nginx
    ;;
  ensure)
    open_web_ports
    write_route
    reload_nginx
    need certbot
    if [[ -n "${JTWZ_CERTBOT_EMAIL:-}" ]]; then
      certbot --nginx --non-interactive --agree-tos --email "$JTWZ_CERTBOT_EMAIL" --redirect --keep-until-expiring -d "$HOSTNAME"
    else
      certbot --nginx --non-interactive --agree-tos --register-unsafely-without-email --redirect --keep-until-expiring -d "$HOSTNAME"
    fi
    certificate_available || die "Certbot 返回成功，但未找到 $HOSTNAME 的证书文件。"
    write_route
    reload_nginx
    ;;
  check)
    certificate_available || die "$HOSTNAME 的证书文件不存在。"
    nginx -t
    nginx_config="$(nginx -T 2>&1)"
    grep -Fq "ssl_certificate $CERT_DIR/fullchain.pem;" <<< "$nginx_config" || die "$HOSTNAME 的 Nginx HTTPS 配置不存在。"
    grep -Eq 'listen[[:space:]]+(\[::\]:)?443[[:space:]]+ssl' <<< "$nginx_config" || die 'Nginx 未监听 443 端口。'
    ;;
  remove)
    command -v certbot >/dev/null 2>&1 && certbot delete --non-interactive --cert-name "$HOSTNAME" >/dev/null 2>&1 || true
    write_route
    reload_nginx
    ;;
  purge)
    command -v certbot >/dev/null 2>&1 && certbot delete --non-interactive --cert-name "$HOSTNAME" >/dev/null 2>&1 || true
    rm -f "$CONF_FILE"
    reload_nginx
    ;;
esac

printf '[JTWZ Domain] %s 完成：%s\n' "$ACTION" "$HOSTNAME"
