#!/usr/bin/env bash
set -Eeuo pipefail

APP_DIR="${JTWZ_APP_DIR:-/opt/jtwz}"
ENV_FILE="$APP_DIR/data/config.env"
[[ -f "$ENV_FILE" ]] || ENV_FILE="$APP_DIR/.env"
SERVICE_NAME="jtwz"
API_URL="${JTWZ_API_URL:-}"
LOCAL_CONTROL_TOKEN=''

say() { printf '\n[JTWZ] %s\n' "$*"; }
die() { printf '[JTWZ][错误] %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null || die "缺少命令：$1"; }
need curl

API_ERROR=''

env_value() { grep -E "^$1=" "$ENV_FILE" 2>/dev/null | cut -d= -f2- | tail -n 1; }
set_env_value() {
  local key="$1" value="$2"
  python3 - "$ENV_FILE" "$key" "$value" <<'PY'
from pathlib import Path
import sys
p = Path(sys.argv[1]); key = sys.argv[2]; value = sys.argv[3]
lines = p.read_text().splitlines() if p.exists() else []
out = []; found = False
for line in lines:
    if line.startswith(key + '='):
        out.append(key + '=' + value); found = True
    else:
        out.append(line)
if not found: out.append(key + '=' + value)
p.write_text('\n'.join(out) + '\n')
PY
}
[[ -n "$API_URL" ]] || API_URL="http://127.0.0.1:$(env_value API_PORT)"
[[ "$API_URL" != 'http://127.0.0.1:' ]] || API_URL='http://127.0.0.1:8787'
restart_service() { if [[ -f "/etc/systemd/system/${SERVICE_NAME}.service" ]]; then systemctl restart "$SERVICE_NAME"; elif command -v docker >/dev/null && [[ -f "$APP_DIR/docker-compose.yml" ]]; then (cd "$APP_DIR" && docker compose restart); fi; }

access_urls() {
  local public_url admin_url admin_origin admin_path address port bind_host host
  public_url="$(env_value PUBLIC_URL)"
  if [[ -z "$public_url" ]]; then
    address="$(env_value PUBLIC_ADDRESS)"; [[ -n "$address" ]] || address="$(env_value PUBLIC_DOMAIN)"
    port="$(env_value API_PORT)"; port="${port:-8787}"
    bind_host="$(env_value API_HOST)"
    host="$address"; [[ "$host" == *:* ]] && host="[$host]"
    if [[ "$bind_host" == '0.0.0.0' || "$bind_host" == '::' ]]; then public_url="http://$host:$port"; else public_url="http://$host"; fi
  fi
  admin_origin="$(env_value ADMIN_APP_ORIGIN)"; admin_origin="${admin_origin:-$public_url}"
  admin_path="$(env_value ADMIN_BASE_PATH)"; admin_path="${admin_path:-/admin}"; admin_path="/${admin_path#/}"; admin_path="${admin_path%/}"
  admin_url="${admin_origin%/}$admin_path/login"
  printf '公开首页：%s/\n管理登录：%s\n' "${public_url%/}" "$admin_url"
}

panel_domain_update() {
  [[ -f "$ENV_FILE" ]] || die "未找到 $ENV_FILE"
  local domain current path scheme origin executor
  current="$(env_value ADMIN_DOMAIN)"; current="${current:-$(env_value ADMIN_ADDRESS)}"
  read -r -p "面板访问域名${current:+ [$current]}: " domain; domain="${domain:-$current}"
  domain="${domain#http://}"; domain="${domain#https://}"; domain="${domain%%/*}"; domain="${domain,,}"
  [[ "$domain" =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$ ]] || die '请输入有效的面板域名，不能填写 IP 或包含路径。'
  executor="${JTWZ_DOMAIN_EXECUTOR:-/usr/local/bin/jtwz-domain}"
  [[ -x "$executor" ]] || die '未找到本机域名执行器，请重新运行一键安装脚本完成升级。'
  "$executor" route "$domain"
  scheme='http'; [[ -r "/etc/letsencrypt/live/$domain/fullchain.pem" ]] && scheme='https'
  origin="$scheme://$domain"
  path="$(env_value ADMIN_BASE_PATH)"; path="${path:-/admin}"; path="/${path#/}"; path="${path%/}"
  set_env_value ADMIN_ADDRESS "$domain"
  set_env_value ADMIN_DOMAIN "$domain"
  set_env_value ADMIN_APP_ORIGIN "$origin"
  set_env_value ADMIN_LOGIN_URL "$origin$path/login"
  if id -u jtwz >/dev/null 2>&1; then chown root:jtwz "$ENV_FILE"; chmod 640 "$ENV_FILE"; else chmod 600 "$ENV_FILE"; fi
  restart_service
  say "面板域名已配置：$origin$path/login"
  say '请确认该域名的 A/AAAA 记录已经指向当前服务器；需要 HTTPS 时继续选择“申请面板 HTTPS 证书”。'
}

panel_https_enable() {
  [[ -f "$ENV_FILE" ]] || die "未找到 $ENV_FILE"
  local domain requested_domain email path origin executor
  domain="$(env_value ADMIN_DOMAIN)"; domain="${domain:-$(env_value ADMIN_ADDRESS)}"
  read -r -p "申请证书的面板域名${domain:+ [$domain]}: " requested_domain; domain="${requested_domain:-$domain}"
  domain="${domain#http://}"; domain="${domain#https://}"; domain="${domain%%/*}"; domain="${domain,,}"
  [[ "$domain" =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$ ]] || die '请先配置有效的面板域名。'
  read -r -p '证书通知邮箱（可留空）: ' email
  executor="${JTWZ_DOMAIN_EXECUTOR:-/usr/local/bin/jtwz-domain}"
  [[ -x "$executor" ]] || die '未找到本机域名执行器，请重新运行一键安装脚本完成升级。'
  JTWZ_CERTBOT_EMAIL="$email" "$executor" ensure "$domain"
  origin="https://$domain"
  path="$(env_value ADMIN_BASE_PATH)"; path="${path:-/admin}"; path="/${path#/}"; path="${path%/}"
  set_env_value ADMIN_ADDRESS "$domain"
  set_env_value ADMIN_DOMAIN "$domain"
  set_env_value ADMIN_APP_ORIGIN "$origin"
  set_env_value ADMIN_LOGIN_URL "$origin$path/login"
  if id -u jtwz >/dev/null 2>&1; then chown root:jtwz "$ENV_FILE"; chmod 640 "$ENV_FILE"; else chmod 600 "$ENV_FILE"; fi
  restart_service
  say "面板 HTTPS 已启用：$origin$path/login"
}

admin_path_update() {
  [[ -f "$ENV_FILE" ]] || die "未找到 $ENV_FILE"
  local next_path="${1:-}" current_path response
  current_path="$(env_value ADMIN_BASE_PATH)"; current_path="${current_path:-/admin}"
  if [[ -z "$next_path" ]]; then read -r -p "新的管理入口后缀 [$current_path]: " next_path; next_path="${next_path:-$current_path}"; fi
  next_path="/${next_path#/}"; next_path="${next_path%/}"; next_path="${next_path,,}"
  [[ "$next_path" =~ ^/[a-z0-9][a-z0-9_-]{3,63}$ ]] || die '管理入口后缀需为 4-64 位字母、数字、短横线或下划线。'
  case "$next_path" in /api|/assets|/admin-assets|/downloads|/preview|/login) die '该管理入口后缀属于系统保留路径。' ;; esac
  response="$(local_api_curl -fsS -H 'Content-Type: application/json' -X PUT -d "$(python3 - "$next_path" <<'PY'
import json, sys
print(json.dumps({'adminBasePath': sys.argv[1]}))
PY
)" "$API_URL/api/admin/access")" || die '管理入口修改失败。'
  [[ -n "$response" ]] || die '管理入口修改失败：服务端没有返回结果。'
  say '新的访问地址'
  access_urls
}

local_control_token() {
  [[ -f "$ENV_FILE" ]] || die "未找到 $ENV_FILE"
  local secret
  secret="$(env_value APP_SECRET)"
  [[ -n "$secret" ]] || die '本机控制凭据缺失，请检查 APP_SECRET 配置。'
  printf 'jtwz-local-control-v1:%s' "$secret" | sha256sum | awk '{print $1}'
}

ensure_local_control() {
  [[ -n "$LOCAL_CONTROL_TOKEN" ]] || LOCAL_CONTROL_TOKEN="$(local_control_token)"
}

local_api_curl() {
  ensure_local_control
  curl -H "X-JTWZ-Local-Control-Token: $LOCAL_CONTROL_TOKEN" "$@"
}

format_domain_list() {
  python3 -c 'import json, sys
data = json.load(sys.stdin)
items = data.get("domains", [])
modes = {"redirect": "跳转", "site": "网站", "download": "下载", "maintenance": "维护"}
statuses = {"active": "正常", "pending": "待配置", "paused": "已暂停", "error": "异常"}
certs = {"active": "HTTPS 已生效", "expiring": "HTTPS 将到期", "error": "HTTPS 异常"}
print(f"域名：{len(items)} 个")
if not items:
    print("暂无域名。")
for index, item in enumerate(items, 1):
    mode = modes.get(item.get("mode"), item.get("mode") or "未知模式")
    status = statuses.get(item.get("status"), item.get("status") or "未知状态")
    cert = certs.get(item.get("certificateStatus"), "未启用 HTTPS")
    print("{}) {} · {} · {} · {}".format(index, item.get("hostname", "-"), mode, status, cert))
    if item.get("target"):
        print("   目标：{}".format(item.get("target")))
    print("   ID：{}".format(item.get("id", "-")))'
}

format_domain_result() {
  python3 -c 'import json, sys
data = json.load(sys.stdin)
item = data.get("domain", data)
hostname = item.get("hostname") if isinstance(item, dict) else None
print(f"域名已保存：{hostname}" if hostname else "域名操作已完成。")'
}

format_backup_list() {
  python3 -c 'import json, sys
data = json.load(sys.stdin)
items = data.get("backups", [])
print(f"备份：{len(items)} 个")
if not items:
    print("暂无备份。")
for index, item in enumerate(items, 1):
    size = float(item.get("byteSize", 0)) / 1024 / 1024
    created = str(item.get("createdAt", "-")).replace("T", " ")[:19]
    print("{}) {} · {:.1f} MB · {}".format(index, item.get("fileName", "-"), size, created))'
}

format_backup_result() {
  python3 -c 'import json, sys
data = json.load(sys.stdin)
item = data.get("backup", data)
name = item.get("fileName") if isinstance(item, dict) else None
size = float(item.get("byteSize", 0)) / 1024 / 1024 if isinstance(item, dict) else 0
print(f"备份已创建：{name}（{size:.1f} MB）" if name else "备份已创建。")'
}

api_call() {
  local raw status body
  API_ERROR=''
  if raw="$(curl -sS -w $'\n%{http_code}' "$@" 2>&1)"; then
    API_STATUS="${raw##*$'\n'}"
    API_BODY="${raw%$'\n'*}"
  else
    API_STATUS='000'
    API_BODY=''
    API_ERROR='无法连接 API，请确认服务正在运行。'
    return 2
  fi
  if [[ ! "$API_STATUS" =~ ^2[0-9][0-9]$ ]]; then
    API_ERROR="$(printf '%s' "$API_BODY" | python3 -c 'import json,sys
try:
 print(json.load(sys.stdin).get("error", "API 请求失败"))
except Exception:
 print("API 请求失败（HTTP " + sys.argv[1] + "）")' "$API_STATUS" 2>/dev/null)"
    [[ -n "$API_ERROR" ]] || API_ERROR="API 请求失败（HTTP $API_STATUS）。"
    return 1
  fi
  return 0
}

domain_list() { local_api_curl -fsS "$API_URL/api/domains" | format_domain_list; }

domain_add() {
  local hostname mode target code
  read -r -p '来源域名: ' hostname
  read -r -p '模式（redirect/site/download/maintenance）[redirect]: ' mode; mode="${mode:-redirect}"
  read -r -p '目标地址或内容（可留空）: ' target
  read -r -p '跳转码（301/302）[302]: ' code; code="${code:-302}"
  local_api_curl -fsS -H 'Content-Type: application/json' -d "$(python3 - "$hostname" "$mode" "$target" "$code" <<'PY'
import json, sys
print(json.dumps({'hostname': sys.argv[1], 'mode': sys.argv[2], 'target': sys.argv[3], 'redirectCode': int(sys.argv[4]), 'preservePath': True, 'preserveQuery': True, 'forceHttps': True}))
PY
)" "$API_URL/api/domains" | format_domain_result
}

domain_update() {
  local id mode target status code
  read -r -p '域名 ID: ' id
  read -r -p '模式（留空保持不变）: ' mode
  read -r -p '目标地址或内容（留空保持不变）: ' target
  read -r -p '状态（active/pending/paused/error，留空保持不变）: ' status
  read -r -p '跳转码（301/302，留空保持不变）: ' code
  local_api_curl -fsS -H 'Content-Type: application/json' -d "$(python3 - "$mode" "$target" "$status" "$code" <<'PY'
import json, sys
body = {}
if sys.argv[1]: body['mode'] = sys.argv[1]
if sys.argv[2]: body['target'] = sys.argv[2]
if sys.argv[3]: body['status'] = sys.argv[3]
if sys.argv[4]: body['redirectCode'] = int(sys.argv[4])
print(json.dumps(body))
PY
)" -X PUT "$API_URL/api/domains/$id" | format_domain_result
}

domain_delete() {
  local id confirm
  read -r -p '域名 ID: ' id
  read -r -p "确认删除域名 $id？输入 DELETE: " confirm
  [[ "$confirm" == DELETE ]] || die '已取消。'
  local_api_curl -fsS -X DELETE "$API_URL/api/domains/$id" >/dev/null
  say '域名已删除。'
}

ssl_list() {
  local cert domain expiry found=false
  say 'HTTPS 证书'
  if [[ ! -d /etc/letsencrypt/live ]]; then say '暂无证书。'; return 0; fi
  for cert in /etc/letsencrypt/live/*/fullchain.pem; do
    [[ -r "$cert" ]] || continue
    found=true
    domain="$(basename "$(dirname "$cert")")"
    if command -v openssl >/dev/null; then
      expiry="$(openssl x509 -enddate -noout -in "$cert" 2>/dev/null | cut -d= -f2-)"
    else
      expiry='未知'
    fi
    printf '%s · 到期：%s\n' "$domain" "${expiry:-未知}"
  done
  [[ "$found" == true ]] || say '暂无证书。'
}

ssl_add() {
  need certbot
  local domain email
  read -r -p '要签发证书的域名: ' domain
  read -r -p '证书通知邮箱: ' email
  certbot --nginx --non-interactive --agree-tos --email "$email" --keep-until-expiring -d "$domain"
  command -v nginx >/dev/null && nginx -t && systemctl reload nginx || true
}

ssl_delete() {
  need certbot
  local domain confirm
  read -r -p '要删除证书的域名: ' domain
  read -r -p "确认删除证书 $domain？输入 DELETE: " confirm
  [[ "$confirm" == DELETE ]] || die '已取消。'
  certbot delete --cert-name "$domain"
  command -v nginx >/dev/null && nginx -t && systemctl reload nginx || true
}

ssl_update() {
  need certbot
  local old_domain new_domain email
  read -r -p '当前证书域名: ' old_domain
  read -r -p '新的证书域名: ' new_domain
  read -r -p '证书通知邮箱: ' email
  certbot delete --cert-name "$old_domain" || true
  certbot --nginx --non-interactive --agree-tos --email "$email" --keep-until-expiring -d "$new_domain"
  command -v nginx >/dev/null && nginx -t && systemctl reload nginx || true
}

config_show() {
  [[ -f "$ENV_FILE" ]] || die "未找到 $ENV_FILE"
  sed -E 's/^(ADMIN_PASSWORD|APP_SECRET|S3_ACCESS_KEY|S3_SECRET_KEY|CLOUDFLARE_API_TOKEN|DNS_WEBHOOK_SECRET|ALERT_WEBHOOK_SECRET|CERTIFICATE_CALLBACK_SECRET)=.*/\1=******/' "$ENV_FILE"
}

config_set() {
  [[ -f "$ENV_FILE" ]] || die "未找到 $ENV_FILE"
  local key value
  read -r -p '配置键（例如 PUBLIC_DOMAIN、ADMIN_APP_ORIGIN、STORAGE_PROVIDER）: ' key
  case "$key" in
    PUBLIC_APP_ORIGIN|ADMIN_APP_ORIGIN|APP_ORIGIN|SUPPORT_EMAIL|STORAGE_PROVIDER|S3_ENDPOINT|S3_BUCKET|S3_PUBLIC_BASE_URL|UPDATE_MANIFEST_URL) ;;
    *) die '该配置键不允许通过 CLI 修改。' ;;
  esac
  read -r -p '新值: ' value
  python3 - "$ENV_FILE" "$key" "$value" <<'PY'
from pathlib import Path
import sys
p = Path(sys.argv[1]); key = sys.argv[2]; value = sys.argv[3]
lines = p.read_text().splitlines()
out = []; found = False
for line in lines:
    if line.startswith(key + '='):
        out.append(key + '=' + value); found = True
    else: out.append(line)
if not found: out.append(key + '=' + value)
p.write_text('\n'.join(out) + '\n')
PY
  if id -u jtwz >/dev/null 2>&1; then chown root:jtwz "$ENV_FILE"; chmod 640 "$ENV_FILE"; else chmod 600 "$ENV_FILE"; fi
  restart_service
  say '配置已保存并重启服务。'
}

backup_create() { local_api_curl -fsS -X POST "$API_URL/api/admin/backups/create" | format_backup_result; }
backup_list() { local_api_curl -fsS "$API_URL/api/admin/backups" | format_backup_list; }

backup_restore() {
  local archive="${1:-}" confirm response
  [[ -n "$archive" ]] || read -r -p '完整备份文件路径: ' archive
  [[ -f "$archive" ]] || die "备份文件不存在：$archive"
  read -r -p '恢复会替换网站数据和运行配置，系统会自动创建回滚备份。输入 RESTORE 继续: ' confirm
  [[ "$confirm" == RESTORE ]] || die '已取消恢复。'
  response="$(local_api_curl -fsS -H 'Content-Type: application/octet-stream' --data-binary "@$archive" "$API_URL/api/admin/import")" || die '恢复失败；服务端会自动尝试回滚，请查看服务日志。'
  [[ -n "$response" ]] || die '恢复失败：服务端没有返回结果。'
  say '完整备份已恢复，正在重启服务使运行配置完全生效。'
  restart_service
  status
}

system_update_safe() {
  local status_json confirm response configured available current latest notes update_token
  update_token="$(local_control_token)"
  say '正在检查带 Ed25519 签名的正式更新清单...'
  if ! api_call -H "X-JTWZ-Local-Control-Token: $update_token" -X POST "$API_URL/api/admin/system/update/check"; then
    die "版本检测失败：${API_ERROR:-未知错误}"
  fi
  status_json="$API_BODY"
  configured="$(printf '%s' "$status_json" | python3 -c 'import json,sys; print(str(json.load(sys.stdin).get("update", {}).get("configured", False)).lower())')"
  [[ "$configured" == true ]] || die "更新源未配置：$(printf '%s' "$status_json" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("update", {}).get("configurationError", "请配置更新清单地址和签名公钥"))')"
  current="$(printf '%s' "$status_json" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("update", {}).get("currentVersion", "未知"))')"
  latest="$(printf '%s' "$status_json" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("update", {}).get("latestVersion", "未知"))')"
  available="$(printf '%s' "$status_json" | python3 -c 'import json,sys; print(str(json.load(sys.stdin).get("update", {}).get("updateAvailable", False)).lower())')"
  notes="$(printf '%s' "$status_json" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("update", {}).get("manifest", {}).get("notes", ""))')"
  say "当前版本：v$current"
  say "可用版本：v$latest"
  [[ -z "$notes" ]] || say "更新说明：$notes"
  [[ "$available" == true ]] || { say '当前已经是最新版本。'; return 0; }
  read -r -p '系统将先创建完整备份，再校验更新包并执行健康检查。输入 UPDATE 继续: ' confirm
  [[ "$confirm" == UPDATE ]] || die '已取消更新。'
  if ! api_call -H "X-JTWZ-Local-Control-Token: $update_token" -X POST "$API_URL/api/admin/system/update/install"; then
    die "更新启动失败：${API_ERROR:-未知错误}"
  fi
  response="$API_BODY"
  if printf '%s' "$response" | grep -q '"applyStarted":true'; then
    say '更新执行器已接管；失败时会自动恢复上一版程序。稍后运行 jt status 查看结果。'
  else
    say '更新包已校验并暂存，但当前部署方式没有配置自动切换执行器；请按面板或容器升级流程切换版本。'
  fi
}

account_update() {
  [[ -f "$ENV_FILE" ]] || die "未找到 $ENV_FILE"
  local current_username new_username new_password
  current_username="$(env_value ADMIN_USERNAME)"
  current_username="${current_username:-admin}"
  read -r -p "新管理员账号 [$current_username]: " new_username; new_username="${new_username:-$current_username}"
  read -r -s -p '新管理员密码（至少 6 位）: ' new_password; printf '\n' >&2
  [[ "${#new_password}" -ge 6 ]] || die '管理员密码至少需要 6 位。'
  local_api_curl -fsS -H 'Content-Type: application/json' -X PUT -d "$(python3 - "$new_password" "$new_username" <<'PY'
import json, sys
print(json.dumps({'newPassword': sys.argv[1], 'newUsername': sys.argv[2]}))
PY
)" "$API_URL/api/admin/account" >/dev/null
  python3 - "$ENV_FILE" "$new_username" "$new_password" <<'PY'
from pathlib import Path
import sys
p = Path(sys.argv[1]); replacements = {'ADMIN_USERNAME': sys.argv[2], 'ADMIN_PASSWORD': sys.argv[3]}
lines = p.read_text().splitlines(); out=[]; seen=set()
for line in lines:
    key = line.split('=', 1)[0] if '=' in line else ''
    if key in replacements: out.append(key + '=' + replacements[key]); seen.add(key)
    else: out.append(line)
for key, value in replacements.items():
    if key not in seen: out.append(key + '=' + value)
p.write_text('\n'.join(out) + '\n')
PY
  if id -u jtwz >/dev/null 2>&1; then chown root:jtwz "$ENV_FILE"; chmod 640 "$ENV_FILE"; else chmod 600 "$ENV_FILE"; fi
  say '管理员账号和密码已更新。'
}

uninstall() {
  local mode="${1:-}" confirm backup_dir
  if [[ -z "$mode" ]]; then read -r -p '卸载模式（keep=保留数据，purge=清除数据）[keep]: ' mode; mode="${mode:-keep}"; fi
  [[ "$mode" == keep || "$mode" == purge ]] || die '卸载模式只能是 keep 或 purge。'
  read -r -p "确认卸载 JTWZ（$mode）？输入 UNINSTALL: " confirm
  [[ "$confirm" == UNINSTALL ]] || die '已取消。'
  if [[ -f "/etc/systemd/system/${SERVICE_NAME}.service" ]]; then systemctl disable --now "$SERVICE_NAME" || true; rm -f "/etc/systemd/system/${SERVICE_NAME}.service"; systemctl daemon-reload; fi
  if command -v docker >/dev/null && [[ -f "$APP_DIR/docker-compose.yml" ]]; then
    if [[ "$mode" == purge ]]; then (cd "$APP_DIR" && docker compose down -v || true); else (cd "$APP_DIR" && docker compose down || true); fi
  fi
  if command -v nginx >/dev/null; then
    rm -f /etc/nginx/conf.d/jtwz.conf /etc/nginx/conf.d/jtwz-domain-*.conf
    nginx -t && systemctl reload nginx || true
  fi
  if [[ "$mode" == keep && -d "$APP_DIR/data" ]]; then
    backup_dir="/opt/jtwz-data-$(date +%Y%m%d-%H%M%S)"
    mv "$APP_DIR/data" "$backup_dir"
    say "数据已保留在：$backup_dir"
  fi
  if [[ "$mode" == purge && -d "$APP_DIR/data" ]]; then rm -rf "$APP_DIR/data"; fi
  rm -rf "$APP_DIR"
  systemctl disable --now jtwz-update.path >/dev/null 2>&1 || true
  systemctl disable --now jtwz-domain.path >/dev/null 2>&1 || true
  rm -f /etc/systemd/system/jtwz-update.path /etc/systemd/system/jtwz-update-apply.service /etc/systemd/system/jtwz-domain.path /etc/systemd/system/jtwz-domain-apply.service
  systemctl daemon-reload
  rm -f /usr/local/bin/jtwzctl /usr/local/bin/jt /usr/local/bin/jtwz-update /usr/local/bin/jtwz-update-dispatch /usr/local/bin/jtwz-domain /usr/local/bin/jtwz-domain-dispatch /etc/sudoers.d/jtwz-update
  if [[ "$mode" == purge ]] && id -u jtwz >/dev/null 2>&1; then userdel jtwz || true; fi
  say 'JTWZ 程序已卸载。SSL 证书不会被自动删除，如需清理请使用 certbot delete。'
}

status() {
  local version node_version disk service_state api_state
  version="$(python3 - "$APP_DIR/package.json" <<'PY'
import json, sys
try:
    print(json.load(open(sys.argv[1], encoding="utf-8")).get("version", "未知"))
except Exception:
    print("未知")
PY
)"
  node_version="$(node --version 2>/dev/null || true)"; node_version="${node_version:-未安装}"
  disk="$(df -hP "$APP_DIR" 2>/dev/null | awk 'NR==2 {print $3 "/" $2 "（" $5 "）"}')"; disk="${disk:-未知}"
  service_state='未运行'
  if [[ -f "/etc/systemd/system/${SERVICE_NAME}.service" ]]; then
    systemctl is-active --quiet "$SERVICE_NAME" && service_state='运行中'
  elif command -v docker >/dev/null && [[ -f "$APP_DIR/docker-compose.yml" ]]; then
    if (cd "$APP_DIR" && docker compose ps --status running -q 2>/dev/null | grep -q .); then service_state='运行中'; fi
  fi
  api_state='异常'
  curl -fsS -o /dev/null "$API_URL/api/health" 2>/dev/null && api_state='正常'
  say '系统状态'
  printf '版本：v%s\n服务：%s · API：%s\nNode：%s · 磁盘：%s\n' "$version" "$service_state" "$api_state" "$node_version" "$disk"
  if [[ -f "$ENV_FILE" ]]; then
    say '访问地址'
    access_urls
  fi
  if [[ -f "$APP_DIR/data/updates/state.json" ]]; then
    python3 - "$APP_DIR/data/updates/state.json" <<'PY'
import json, sys
try:
    data = json.load(open(sys.argv[1], encoding="utf-8"))
    labels = {"idle": "空闲", "checking": "检查中", "downloading": "下载中", "installing": "安装中", "completed": "已完成", "failed": "失败", "rolled-back": "已回滚"}
    status = labels.get(data.get("status"), data.get("status") or "未知")
    version = data.get("version") or "-"
    print(f"最近更新：{status} · v{version}")
    if data.get("detail") and data.get("status") in {"failed", "rolled-back"}:
        print(f"原因：{data['detail']}")
except Exception:
    pass
PY
  fi
}

service_logs() {
  say '最近 50 行服务日志'
  if [[ -f "/etc/systemd/system/${SERVICE_NAME}.service" ]]; then
    journalctl -u "$SERVICE_NAME" --no-pager -n 50 -o short-iso
  elif command -v docker >/dev/null && [[ -f "$APP_DIR/docker-compose.yml" ]]; then
    (cd "$APP_DIR" && docker compose logs --tail 50)
  else
    die '未找到可读取的 systemd 或 Docker 服务。'
  fi
}

ssl_renew() {
  need certbot
  certbot renew
  if command -v nginx >/dev/null; then
    nginx -t
    systemctl reload nginx
  fi
}

pause_menu() {
  printf '\n'
  read -r -p '按 Enter 返回菜单...' _ || true
}

run_menu_action() {
  local exit_code=0
  set +e
  ( set -e; "$@" )
  exit_code=$?
  set -e
  if (( exit_code != 0 )); then
    say '操作未完成，请根据上方提示检查后重试。'
  fi
  pause_menu
}

