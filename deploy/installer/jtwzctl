#!/usr/bin/env bash
set -Eeuo pipefail

APP_DIR="${JTWZ_APP_DIR:-/opt/jtwz}"
ENV_FILE="$APP_DIR/data/config.env"
[[ -f "$ENV_FILE" ]] || ENV_FILE="$APP_DIR/.env"
SERVICE_NAME="jtwz"
API_URL="${JTWZ_API_URL:-}"
COOKIE_FILE="${TMPDIR:-/tmp}/jtwzctl-$$.cookie"
trap 'rm -f "$COOKIE_FILE"' EXIT

say() { printf '\n[JTWZ] %s\n' "$*"; }
die() { printf '[JTWZ][错误] %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null || die "缺少命令：$1"; }
need curl

LOGIN_ERROR=''
API_ERROR=''

env_value() { grep -E "^$1=" "$ENV_FILE" 2>/dev/null | cut -d= -f2- | tail -n 1; }
[[ -n "$API_URL" ]] || API_URL="http://127.0.0.1:$(env_value API_PORT)"
[[ "$API_URL" != 'http://127.0.0.1:' ]] || API_URL='http://127.0.0.1:8787'
restart_service() { if [[ -f "/etc/systemd/system/${SERVICE_NAME}.service" ]]; then systemctl restart "$SERVICE_NAME"; elif command -v docker >/dev/null && [[ -f "$APP_DIR/docker-compose.yml" ]]; then (cd "$APP_DIR" && docker compose restart); fi; }

access_urls() {
  local public_url admin_url admin_origin admin_path address port bind_host host
  public_url="$(env_value PUBLIC_URL)"
  if [[ -z "$public_url" ]]; then
    address="$(env_value PUBLIC_ADDRESS)"; [[ -n "$address" ]] || address="$(env_value PUBLIC_DOMAIN)"
    port="$(env_value API_PORT)"; port="${port:-8787}"
    bind_host="$(env_value API_HOST)"
    host="$address"; [[ "$host" == *:* ]] && host="[$host]"
    if [[ "$bind_host" == '0.0.0.0' || "$bind_host" == '::' ]]; then public_url="http://$host:$port"; else public_url="http://$host"; fi
  fi
  admin_origin="$(env_value ADMIN_APP_ORIGIN)"; admin_origin="${admin_origin:-$public_url}"
  admin_path="$(env_value ADMIN_BASE_PATH)"; admin_path="${admin_path:-/admin}"; admin_path="/${admin_path#/}"; admin_path="${admin_path%/}"
  admin_url="${admin_origin%/}$admin_path/login"
  printf '公开首页：%s/\n管理登录：%s\n' "${public_url%/}" "$admin_url"
}

admin_path_update() {
  [[ -f "$ENV_FILE" ]] || die "未找到 $ENV_FILE"
  local next_path="${1:-}" current_path username password response
  current_path="$(env_value ADMIN_BASE_PATH)"; current_path="${current_path:-/admin}"
  if [[ -z "$next_path" ]]; then read -r -p "新的管理入口后缀 [$current_path]: " next_path; next_path="${next_path:-$current_path}"; fi
  next_path="/${next_path#/}"; next_path="${next_path%/}"; next_path="${next_path,,}"
  [[ "$next_path" =~ ^/[a-z0-9][a-z0-9_-]{3,63}$ ]] || die '管理入口后缀需为 4-64 位字母、数字、短横线或下划线。'
  case "$next_path" in /api|/assets|/admin-assets|/downloads|/preview|/login) die '该管理入口后缀属于系统保留路径。' ;; esac
  username="$(env_value ADMIN_USERNAME)"; password="$(env_value ADMIN_PASSWORD)"
  if [[ -z "$username" || -z "$password" ]]; then
    read -r -p '管理员账号: ' username
    read -r -s -p '当前管理员密码: ' password; printf '\n' >&2
  fi
  if ! api_login_with "$username" "$password"; then die "API 登录失败：${LOGIN_ERROR:-未知错误}"; fi
  response="$(curl -fsS -b "$COOKIE_FILE" -H 'Content-Type: application/json' -X PUT -d "$(python3 - "$password" "$next_path" <<'PY'
import json, sys
print(json.dumps({'currentPassword': sys.argv[1], 'adminBasePath': sys.argv[2]}))
PY
)" "$API_URL/api/admin/access")" || die '管理入口修改失败。'
  printf '%s' "$response" | pretty_json
  say '新的访问地址'
  access_urls
}

api_login() {
  [[ -f "$ENV_FILE" ]] || die "未找到 $ENV_FILE"
  local username password
  username="$(env_value ADMIN_USERNAME)"; password="$(env_value ADMIN_PASSWORD)"
  if [[ -z "$username" || -z "$password" ]]; then
    read -r -p '管理员账号: ' username
    read -r -s -p '管理员密码: ' password; printf '\n' >&2
  fi
  if api_login_with "$username" "$password"; then return 0; fi
  say "保存的管理员凭据登录失败：${LOGIN_ERROR:-未知错误}"
  read -r -p "管理员账号 [$username]: " retry_username; retry_username="${retry_username:-$username}"
  read -r -s -p '管理员密码: ' retry_password; printf '\n' >&2
  if ! api_login_with "$retry_username" "$retry_password"; then
    die "API 登录失败：${LOGIN_ERROR:-未知错误}"
  fi
}

api_login_with() {
  local username="$1" password="$2" response status body challenge code
  LOGIN_ERROR=''
  if response="$(curl -sS -w $'\n%{http_code}' -c "$COOKIE_FILE" -H 'Content-Type: application/json' -d "$(python3 - "$username" "$password" <<'PY'
import json, sys
print(json.dumps({'username': sys.argv[1], 'password': sys.argv[2]}))
PY
 )" "$API_URL/api/auth/login" 2>&1)"; then
    status="${response##*$'\n'}"
    body="${response%$'\n'*}"
  else
    LOGIN_ERROR='无法连接 API，请确认服务正在运行。'
    return 2
  fi
  if [[ ! "$status" =~ ^2[0-9][0-9]$ ]]; then
    LOGIN_ERROR="$(printf '%s' "$body" | python3 -c 'import json,sys
try:
 print(json.load(sys.stdin).get("error", "API 登录失败"))
except Exception:
 print("API 登录失败（HTTP " + sys.argv[1] + "）")' "$status" 2>/dev/null)"
    [[ -n "$LOGIN_ERROR" ]] || LOGIN_ERROR="API 登录失败（HTTP $status）。"
    return 1
  fi
  if printf '%s' "$body" | grep -q '"requiresTwoFactor":true'; then
    challenge="$(printf '%s' "$body" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("challengeId", ""))')"
    if [[ -z "$challenge" ]]; then LOGIN_ERROR='服务器要求双重验证，但未返回验证挑战。'; return 1; fi
    read -r -p '动态验证码或恢复码: ' code
    if ! response="$(curl -sS -w $'\n%{http_code}' -b "$COOKIE_FILE" -c "$COOKIE_FILE" -H 'Content-Type: application/json' -d "$(python3 - "$challenge" "$code" <<'PY'
import json, sys
print(json.dumps({'challengeId': sys.argv[1], 'code': sys.argv[2]}))
PY
 )" "$API_URL/api/auth/two-factor" 2>&1)"; then
      LOGIN_ERROR='无法连接 API，双重验证未完成。'
      return 2
    fi
    status="${response##*$'\n'}"
    body="${response%$'\n'*}"
    if [[ ! "$status" =~ ^2[0-9][0-9]$ ]]; then
      LOGIN_ERROR="$(printf '%s' "$body" | python3 -c 'import json,sys
try:
 print(json.load(sys.stdin).get("error", "双重验证失败"))
except Exception:
 print("双重验证失败（HTTP " + sys.argv[1] + "）")' "$status" 2>/dev/null)"
      [[ -n "$LOGIN_ERROR" ]] || LOGIN_ERROR="双重验证失败（HTTP $status）。"
      return 1
    fi
  fi
  printf '%s' "$body" | grep -q '"username"' || { LOGIN_ERROR='API 登录未返回有效会话。'; return 1; }
  return 0
}

pretty_json() { if command -v python3 >/dev/null; then python3 -m json.tool; else cat; fi; }

api_call() {
  local raw status body
  API_ERROR=''
  if raw="$(curl -sS -w $'\n%{http_code}' "$@" 2>&1)"; then
    API_STATUS="${raw##*$'\n'}"
    API_BODY="${raw%$'\n'*}"
  else
    API_STATUS='000'
    API_BODY=''
    API_ERROR='无法连接 API，请确认服务正在运行。'
    return 2
  fi
  if [[ ! "$API_STATUS" =~ ^2[0-9][0-9]$ ]]; then
    API_ERROR="$(printf '%s' "$API_BODY" | python3 -c 'import json,sys
try:
 print(json.load(sys.stdin).get("error", "API 请求失败"))
except Exception:
 print("API 请求失败（HTTP " + sys.argv[1] + "）")' "$API_STATUS" 2>/dev/null)"
    [[ -n "$API_ERROR" ]] || API_ERROR="API 请求失败（HTTP $API_STATUS）。"
    return 1
  fi
  return 0
}

domain_list() { api_login; curl -fsS -b "$COOKIE_FILE" "$API_URL/api/domains" | pretty_json; }

domain_add() {
  api_login
  local hostname mode target code
  read -r -p '来源域名: ' hostname
  read -r -p '模式（redirect/site/download/maintenance）[redirect]: ' mode; mode="${mode:-redirect}"
  read -r -p '目标地址或内容（可留空）: ' target
  read -r -p '跳转码（301/302）[302]: ' code; code="${code:-302}"
  curl -fsS -b "$COOKIE_FILE" -H 'Content-Type: application/json' -d "$(python3 - "$hostname" "$mode" "$target" "$code" <<'PY'
import json, sys
print(json.dumps({'hostname': sys.argv[1], 'mode': sys.argv[2], 'target': sys.argv[3], 'redirectCode': int(sys.argv[4]), 'preservePath': True, 'preserveQuery': True, 'forceHttps': True}))
PY
)" "$API_URL/api/domains" | pretty_json
}

domain_update() {
  api_login
  local id mode target status code
  read -r -p '域名 ID: ' id
  read -r -p '模式（留空保持不变）: ' mode
  read -r -p '目标地址或内容（留空保持不变）: ' target
  read -r -p '状态（active/pending/paused/error，留空保持不变）: ' status
  read -r -p '跳转码（301/302，留空保持不变）: ' code
  curl -fsS -b "$COOKIE_FILE" -H 'Content-Type: application/json' -d "$(python3 - "$mode" "$target" "$status" "$code" <<'PY'
import json, sys
body = {}
if sys.argv[1]: body['mode'] = sys.argv[1]
if sys.argv[2]: body['target'] = sys.argv[2]
if sys.argv[3]: body['status'] = sys.argv[3]
if sys.argv[4]: body['redirectCode'] = int(sys.argv[4])
print(json.dumps(body))
PY
)" -X PUT "$API_URL/api/domains/$id" | pretty_json
}

domain_delete() {
  api_login
  local id confirm
  read -r -p '域名 ID: ' id
  read -r -p "确认删除域名 $id？输入 DELETE: " confirm
  [[ "$confirm" == DELETE ]] || die '已取消。'
  curl -fsS -b "$COOKIE_FILE" -X DELETE "$API_URL/api/domains/$id" | pretty_json
}

ssl_list() {
  if command -v certbot >/dev/null; then certbot certificates || true; else say '未安装 certbot。'; fi
  if [[ -d /etc/letsencrypt/live ]]; then find /etc/letsencrypt/live -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort; fi
}

ssl_add() {
  need certbot
  local domain email
  read -r -p '要签发证书的域名: ' domain
  read -r -p '证书通知邮箱: ' email
  certbot --nginx --non-interactive --agree-tos --email "$email" --keep-until-expiring -d "$domain"
  command -v nginx >/dev/null && nginx -t && systemctl reload nginx || true
}

ssl_delete() {
  need certbot
  local domain confirm
  read -r -p '要删除证书的域名: ' domain
  read -r -p "确认删除证书 $domain？输入 DELETE: " confirm
  [[ "$confirm" == DELETE ]] || die '已取消。'
  certbot delete --cert-name "$domain"
  command -v nginx >/dev/null && nginx -t && systemctl reload nginx || true
}

ssl_update() {
  need certbot
  local old_domain new_domain email
  read -r -p '当前证书域名: ' old_domain
  read -r -p '新的证书域名: ' new_domain
  read -r -p '证书通知邮箱: ' email
  certbot delete --cert-name "$old_domain" || true
  certbot --nginx --non-interactive --agree-tos --email "$email" --keep-until-expiring -d "$new_domain"
  command -v nginx >/dev/null && nginx -t && systemctl reload nginx || true
}

config_show() {
  [[ -f "$ENV_FILE" ]] || die "未找到 $ENV_FILE"
  sed -E 's/^(ADMIN_PASSWORD|APP_SECRET|S3_ACCESS_KEY|S3_SECRET_KEY|CLOUDFLARE_API_TOKEN|DNS_WEBHOOK_SECRET|ALERT_WEBHOOK_SECRET|CERTIFICATE_CALLBACK_SECRET)=.*/\1=******/' "$ENV_FILE"
}

config_set() {
  [[ -f "$ENV_FILE" ]] || die "未找到 $ENV_FILE"
  local key value
  read -r -p '配置键（例如 PUBLIC_DOMAIN、ADMIN_APP_ORIGIN、STORAGE_PROVIDER）: ' key
  case "$key" in
    PUBLIC_APP_ORIGIN|ADMIN_APP_ORIGIN|APP_ORIGIN|SUPPORT_EMAIL|STORAGE_PROVIDER|S3_ENDPOINT|S3_BUCKET|S3_PUBLIC_BASE_URL|UPDATE_MANIFEST_URL) ;;
    *) die '该配置键不允许通过 CLI 修改。' ;;
  esac
  read -r -p '新值: ' value
  python3 - "$ENV_FILE" "$key" "$value" <<'PY'
from pathlib import Path
import sys
p = Path(sys.argv[1]); key = sys.argv[2]; value = sys.argv[3]
lines = p.read_text().splitlines()
out = []; found = False
for line in lines:
    if line.startswith(key + '='):
        out.append(key + '=' + value); found = True
    else: out.append(line)
if not found: out.append(key + '=' + value)
p.write_text('\n'.join(out) + '\n')
PY
  if id -u jtwz >/dev/null 2>&1; then chown root:jtwz "$ENV_FILE"; chmod 640 "$ENV_FILE"; else chmod 600 "$ENV_FILE"; fi
  restart_service
  say '配置已保存并重启服务。'
}

backup_create() { api_login; curl -fsS -b "$COOKIE_FILE" -X POST "$API_URL/api/admin/backups/create" | pretty_json; }
backup_list() { api_login; curl -fsS -b "$COOKIE_FILE" "$API_URL/api/admin/backups" | pretty_json; }

backup_restore() {
  local archive="${1:-}" confirm response
  [[ -n "$archive" ]] || read -r -p '完整备份文件路径: ' archive
  [[ -f "$archive" ]] || die "备份文件不存在：$archive"
  read -r -p '恢复会替换网站数据和运行配置，系统会自动创建回滚备份。输入 RESTORE 继续: ' confirm
  [[ "$confirm" == RESTORE ]] || die '已取消恢复。'
  api_login
  response="$(curl -fsS -b "$COOKIE_FILE" -H 'Content-Type: application/octet-stream' --data-binary "@$archive" "$API_URL/api/admin/import")" || die '恢复失败；服务端会自动尝试回滚，请查看服务日志。'
  printf '%s' "$response" | pretty_json
  say '完整备份已恢复，正在重启服务使运行配置完全生效。'
  restart_service
  status
}

system_update_safe() {
  local status_json confirm response configured available current latest notes
  api_login
  say '正在检查带 Ed25519 签名的正式更新清单...'
  if ! api_call -b "$COOKIE_FILE" -X POST "$API_URL/api/admin/system/update/check"; then
    die "版本检测失败：${API_ERROR:-未知错误}"
  fi
  status_json="$API_BODY"
  printf '%s' "$status_json" | pretty_json
  configured="$(printf '%s' "$status_json" | python3 -c 'import json,sys; print(str(json.load(sys.stdin).get("update", {}).get("configured", False)).lower())')"
  [[ "$configured" == true ]] || die "更新源未配置：$(printf '%s' "$status_json" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("update", {}).get("configurationError", "请配置更新清单地址和签名公钥"))')"
  current="$(printf '%s' "$status_json" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("update", {}).get("currentVersion", "未知"))')"
  latest="$(printf '%s' "$status_json" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("update", {}).get("latestVersion", "未知"))')"
  available="$(printf '%s' "$status_json" | python3 -c 'import json,sys; print(str(json.load(sys.stdin).get("update", {}).get("updateAvailable", False)).lower())')"
  notes="$(printf '%s' "$status_json" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("update", {}).get("manifest", {}).get("notes", ""))')"
  say "当前版本：v$current"
  say "可用版本：v$latest"
  [[ -z "$notes" ]] || say "更新说明：$notes"
  [[ "$available" == true ]] || { say '当前已经是最新版本。'; return 0; }
  read -r -p '系统将先创建完整备份，再校验更新包并执行健康检查。输入 UPDATE 继续: ' confirm
  [[ "$confirm" == UPDATE ]] || die '已取消更新。'
  if ! api_call -b "$COOKIE_FILE" -X POST "$API_URL/api/admin/system/update/install"; then
    die "更新启动失败：${API_ERROR:-未知错误}"
  fi
  response="$API_BODY"
  printf '%s' "$response" | pretty_json
  if printf '%s' "$response" | grep -q '"applyStarted":true'; then
    say '更新执行器已接管；失败时会自动恢复上一版程序。稍后运行 jt status 查看结果。'
  else
    say '更新包已校验并暂存，但当前部署方式没有配置自动切换执行器；请按面板或容器升级流程切换版本。'
  fi
}

account_update() {
  [[ -f "$ENV_FILE" ]] || die "未找到 $ENV_FILE"
  local current_username current_password new_username new_password value
  current_username="$(env_value ADMIN_USERNAME)"
  current_password="$(env_value ADMIN_PASSWORD)"
  if [[ -z "$current_username" || -z "$current_password" ]]; then
    read -r -p '当前管理员账号: ' current_username
    read -r -s -p '当前管理员密码: ' current_password; printf '\n' >&2
  fi
  read -r -p "新管理员账号 [$current_username]: " new_username; new_username="${new_username:-$current_username}"
  read -r -s -p '新管理员密码（至少 6 位）: ' new_password; printf '\n' >&2
  [[ "${#new_password}" -ge 6 ]] || die '管理员密码至少需要 6 位。'
  if ! api_login_with "$current_username" "$current_password"; then die "API 登录失败：${LOGIN_ERROR:-未知错误}"; fi
  curl -fsS -b "$COOKIE_FILE" -H 'Content-Type: application/json' -X PUT -d "$(python3 - "$current_password" "$new_password" "$new_username" <<'PY'
import json, sys
print(json.dumps({'currentPassword': sys.argv[1], 'newPassword': sys.argv[2], 'newUsername': sys.argv[3]}))
PY
)" "$API_URL/api/admin/account" | pretty_json
  python3 - "$ENV_FILE" "$new_username" "$new_password" <<'PY'
from pathlib import Path
import sys
p = Path(sys.argv[1]); replacements = {'ADMIN_USERNAME': sys.argv[2], 'ADMIN_PASSWORD': sys.argv[3]}
lines = p.read_text().splitlines(); out=[]; seen=set()
for line in lines:
    key = line.split('=', 1)[0] if '=' in line else ''
    if key in replacements: out.append(key + '=' + replacements[key]); seen.add(key)
    else: out.append(line)
for key, value in replacements.items():
    if key not in seen: out.append(key + '=' + value)
p.write_text('\n'.join(out) + '\n')
PY
  if id -u jtwz >/dev/null 2>&1; then chown root:jtwz "$ENV_FILE"; chmod 640 "$ENV_FILE"; else chmod 600 "$ENV_FILE"; fi
  say '管理员账号和密码已更新。'
}

uninstall() {
  local mode="${1:-}" confirm backup_dir
  if [[ -z "$mode" ]]; then read -r -p '卸载模式（keep=保留数据，purge=清除数据）[keep]: ' mode; mode="${mode:-keep}"; fi
  [[ "$mode" == keep || "$mode" == purge ]] || die '卸载模式只能是 keep 或 purge。'
  read -r -p "确认卸载 JTWZ（$mode）？输入 UNINSTALL: " confirm
  [[ "$confirm" == UNINSTALL ]] || die '已取消。'
  if [[ -f "/etc/systemd/system/${SERVICE_NAME}.service" ]]; then systemctl disable --now "$SERVICE_NAME" || true; rm -f "/etc/systemd/system/${SERVICE_NAME}.service"; systemctl daemon-reload; fi
  if command -v docker >/dev/null && [[ -f "$APP_DIR/docker-compose.yml" ]]; then
    if [[ "$mode" == purge ]]; then (cd "$APP_DIR" && docker compose down -v || true); else (cd "$APP_DIR" && docker compose down || true); fi
  fi
  if command -v nginx >/dev/null && [[ -f /etc/nginx/conf.d/jtwz.conf ]]; then rm -f /etc/nginx/conf.d/jtwz.conf; nginx -t && systemctl reload nginx || true; fi
  if [[ "$mode" == keep && -d "$APP_DIR/data" ]]; then
    backup_dir="/opt/jtwz-data-$(date +%Y%m%d-%H%M%S)"
    mv "$APP_DIR/data" "$backup_dir"
    say "数据已保留在：$backup_dir"
  fi
  if [[ "$mode" == purge && -d "$APP_DIR/data" ]]; then rm -rf "$APP_DIR/data"; fi
  rm -rf "$APP_DIR"
  rm -f /usr/local/bin/jtwzctl /usr/local/bin/jt /usr/local/bin/jtwz-update /etc/sudoers.d/jtwz-update
  if [[ "$mode" == purge ]] && id -u jtwz >/dev/null 2>&1; then userdel jtwz || true; fi
  say 'JTWZ 程序已卸载。SSL 证书不会被自动删除，如需清理请使用 certbot delete。'
}

status() {
  say '系统信息'; uname -a; printf 'Node: '; node --version 2>/dev/null || printf '未安装\n'; printf '磁盘: '; df -h "$APP_DIR" | tail -n 1
  if [[ -f "/etc/systemd/system/${SERVICE_NAME}.service" ]]; then systemctl --no-pager --full status "$SERVICE_NAME" || true; elif command -v docker >/dev/null && [[ -f "$APP_DIR/docker-compose.yml" ]]; then (cd "$APP_DIR" && docker compose ps); fi
  curl -fsS "$API_URL/api/health" 2>/dev/null | pretty_json || say 'API 暂不可用。'
  if [[ -f "$ENV_FILE" ]]; then
    say '访问地址'
    access_urls
  fi
  if [[ -f "$APP_DIR/data/updates/state.json" ]]; then say '最近更新状态'; cat "$APP_DIR/data/updates/state.json" | pretty_json; fi
}

service_logs() {
  if [[ -f "/etc/systemd/system/${SERVICE_NAME}.service" ]]; then
    journalctl -u "$SERVICE_NAME" --no-pager -n 100
  elif command -v docker >/dev/null && [[ -f "$APP_DIR/docker-compose.yml" ]]; then
    (cd "$APP_DIR" && docker compose logs --tail 100)
  else
    die '未找到可读取的 systemd 或 Docker 服务。'
  fi
}

menu() {
  while true; do
    printf '\n%s\n' '============================================================'
    printf '%s\n' '                    JTWZ 服务器管理'
    printf '%s\n' '============================================================'
    printf '应用目录：%s\n服务地址：%s\n\n' "$APP_DIR" "$API_URL"
    cat <<'EOF'
[系统]
  1) 查看系统与服务状态
  2) 查看当前访问地址
  3) 修改管理后台入口
  17) 检查并更新系统
  18) 重启服务
  22) 查看最近服务日志

[域名与证书]
  4) 查看域名
  5) 添加域名
  6) 修改域名
  7) 删除域名
  8) 查看 SSL 证书
  9) 添加 SSL 证书
  10) 删除 SSL 证书
  11) 修改 SSL 域名

[账号、配置与备份]
  12) 修改管理员账号密码
  13) 查看配置
  14) 修改配置
  15) 创建完整备份
  16) 查看备份
  21) 上传完整备份并恢复

[卸载]
  19) 卸载并保留数据
  20) 卸载并清除数据
  0) 退出
EOF
    local choice; read -r -p '请输入编号: ' choice
    case "$choice" in
      1) status ;; 2) access_urls ;; 3) admin_path_update ;; 4) domain_list ;; 5) domain_add ;; 6) domain_update ;; 7) domain_delete ;; 8) ssl_list ;; 9) ssl_add ;; 10) ssl_delete ;; 11) ssl_update ;; 12) account_update ;; 13) config_show ;; 14) config_set ;; 15) backup_create ;; 16) backup_list ;; 17) system_update_safe ;; 18) restart_service; status ;; 19) uninstall keep ;; 20) uninstall purge ;; 21) backup_restore ;; 22) service_logs ;; 0) break ;; *) say '无效选项。' ;;
    esac
  done
}

case "${1:-menu}" in
  menu) menu ;;
  status|info) status ;;
  access|urls) access_urls ;;
  admin-path) case "${2:-show}" in show) access_urls ;; set|update) admin_path_update "${3:-}" ;; *) die '用法：jtwzctl admin-path {show|set [后缀]}' ;; esac ;;
  domain) case "${2:-list}" in list) domain_list ;; add) domain_add ;; update|edit) domain_update ;; delete|remove) domain_delete ;; *) die '用法：jtwzctl domain {list|add|update|delete}' ;; esac ;;
  ssl) case "${2:-list}" in list) ssl_list ;; add) ssl_add ;; update|edit) ssl_update ;; delete|remove) ssl_delete ;; renew) need certbot; certbot renew; command -v nginx >/dev/null && systemctl reload nginx || true ;; *) die '用法：jtwzctl ssl {list|add|update|delete|renew}' ;; esac ;;
  config) case "${2:-show}" in show) config_show ;; set|update) config_set ;; *) die '用法：jtwzctl config {show|set}' ;; esac ;;
  backup) case "${2:-create}" in create) backup_create ;; list) backup_list ;; restore|import) backup_restore "${3:-}" ;; *) die '用法：jtwzctl backup {create|list|restore [文件]}' ;; esac ;;
  update|upgrade) system_update_safe ;;
  account) account_update ;;
  uninstall) uninstall ;;
  restart) restart_service ;;
  logs) service_logs ;;
  *) die '用法：jtwzctl {menu|status|logs|access|admin-path|domain|ssl|config|account|backup|update|uninstall|restart}' ;;
esac
