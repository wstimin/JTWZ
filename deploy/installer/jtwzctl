menu() {
  while true; do
    printf '\n%s\n' '============================================================'
    printf '%s\n' '                    JTWZ 服务器管理'
    printf '%s\n' '============================================================'
    printf '应用目录：%s\n服务地址：%s\n\n' "$APP_DIR" "$API_URL"
    cat <<'EOF'
[主菜单]
  1) 查看系统与服务状态
  2) 检查并更新系统
  3) 域名与 HTTPS
  4) 管理后台与账号
  5) 系统配置
  6) 备份与恢复
  7) 服务维护
  8) 查看最近服务日志
  9) 卸载系统（危险操作）
  0) 退出
EOF
    local choice; read -r -p '请输入编号: ' choice
    case "$choice" in
      1) run_menu_action status ;;
      2) run_menu_action system_update_safe ;;
      3) domain_https_menu ;;
      4) admin_account_menu ;;
      5) system_config_menu ;;
      6) backup_menu ;;
      7) service_menu ;;
      8) run_menu_action service_logs ;;
      9) uninstall_menu ;;
      0) break ;;
      *) say '无效选项。' ;;
    esac
  done
}

case "${1:-menu}" in
  menu) menu ;;
  status|info) status ;;
  access|urls) access_urls ;;
  panel-domain) panel_domain_update ;;
  panel-https) panel_https_enable ;;
  admin-path) case "${2:-show}" in show) access_urls ;; set|update) admin_path_update "${3:-}" ;; *) die '用法：jtwzctl admin-path {show|set [后缀]}' ;; esac ;;
  domain) case "${2:-list}" in list) domain_list ;; add) domain_add ;; update|edit) domain_update ;; delete|remove) domain_delete ;; *) die '用法：jtwzctl domain {list|add|update|delete}' ;; esac ;;
  ssl) case "${2:-list}" in list) ssl_list ;; add) ssl_add ;; update|edit) ssl_update ;; delete|remove) ssl_delete ;; renew) ssl_renew ;; *) die '用法：jtwzctl ssl {list|add|update|delete|renew}' ;; esac ;;
  config) case "${2:-show}" in show) config_show ;; set|update) config_set ;; *) die '用法：jtwzctl config {show|set}' ;; esac ;;
  backup) case "${2:-create}" in create) backup_create ;; list) backup_list ;; restore|import) backup_restore "${3:-}" ;; *) die '用法：jtwzctl backup {create|list|restore [文件]}' ;; esac ;;
  update|upgrade) system_update_safe ;;
  account) account_update ;;
  uninstall) uninstall ;;
  restart) restart_service ;;
  logs) service_logs ;;
  *) die '用法：jtwzctl {menu|status|logs|access|panel-domain|panel-https|admin-path|domain|ssl|config|account|backup|update|uninstall|restart}' ;;
esac
